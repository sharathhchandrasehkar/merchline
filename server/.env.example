# Postgres connection string. Neon gives you one ending in ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5433/merchline
PORT=3000
# How many styles to generate on first boot (about 85 MB of data at 3000; Neon free has 1 GB per project)
SEED_STYLES=3000
# Optional: lets Claude read questions in "Ask Merchline". Without it, a keyword parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Comma-separated origins allowed to call the API (your static site URL). Empty allows any origin.
CORS_ORIGIN=
